# Copy this file to .env and replace the example credentials. Do not commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/nurse_schedule_db
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGINS=http://localhost:5173
ADMIN_INITIAL_PASSWORD=change-me-before-seeding
STAFF_INITIAL_PASSWORD=change-me-before-provisioning-staff
